<UserControl x:Class="Wilt.Controls.ProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Ellipse Stroke="{Binding TrackBrush, ElementName=Root}"
                  StrokeThickness="{Binding Thickness, ElementName=Root}"
                  Width="{Binding Diameter, ElementName=Root}"
                  Height="{Binding Diameter, ElementName=Root}" />
        <Path x:Name="ArcPath"
              Stroke="{Binding ProgressBrush, ElementName=Root}"
              StrokeThickness="{Binding Thickness, ElementName=Root}"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" />
    </Grid>
</UserControl>
