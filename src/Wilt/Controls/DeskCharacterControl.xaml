<UserControl x:Class="Wilt.Controls.DeskCharacterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="170" Height="166" SnapsToDevicePixels="True">
    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="195" Background="Transparent">

            <!-- Soft accent glow behind the character (re-colored per skin) -->
            <Ellipse x:Name="Glow" Canvas.Left="25" Canvas.Top="0" Width="150" Height="130" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowStopInner" Color="#552E7D6B" Offset="0" />
                        <GradientStop x:Name="GlowStopOuter" Color="#002E7D6B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="18" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- Zzz whimsy motif, off by default (PRD 8 'Could have') -->
            <TextBlock x:Name="ZzzMotif" Canvas.Left="150" Canvas.Top="4" Text="z z z" FontSize="16"
                       FontWeight="Bold" Foreground="#AAFFFFFF" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="ZzzRotate" Angle="-10" />
                </TextBlock.RenderTransform>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Whole-body group: single continuous Energy-driven pivot (lean/sink/breathe) -->
            <Grid x:Name="BodyGroup" RenderTransformOrigin="0.5,1" Canvas.Left="0" Canvas.Top="0" Width="200" Height="195">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1" CenterX="100" CenterY="195" />
                        <RotateTransform x:Name="BodyRotate" Angle="0" CenterX="100" CenterY="195" />
                        <TranslateTransform x:Name="BodyTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Canvas>
                    <Image x:Name="CharacterImage" Canvas.Left="0" Canvas.Top="0" Width="200" Height="195"
                           Source="/Wilt;component/Resources/Characters/student_desk.png" Stretch="Uniform" />

                    <!-- Tiredness dimming overlay, opacity rises with fatigue -->
                    <Rectangle x:Name="TiredOverlay" Canvas.Left="0" Canvas.Top="0" Width="200" Height="195"
                               Fill="#1A1015" Opacity="0" IsHitTestVisible="False" />

                    <!-- Eyelids: skin-toned ellipses over each eye, scaled down to 0 (open) by default -->
                    <Ellipse x:Name="EyeLidLeft" Canvas.Left="80" Canvas.Top="53" Width="20" Height="13"
                             Fill="#F0C199" RenderTransformOrigin="0.5,0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="EyeLidLeftScale" ScaleY="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="EyeLidRight" Canvas.Left="106" Canvas.Top="60" Width="20" Height="13"
                             Fill="#F0C199" RenderTransformOrigin="0.5,0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="EyeLidRightScale" ScaleY="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Canvas>
    </Viewbox>
</UserControl>
