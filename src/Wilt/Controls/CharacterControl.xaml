<UserControl x:Class="Wilt.Controls.CharacterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="200" Height="200" SnapsToDevicePixels="True">
    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="200" Background="Transparent">

            <!-- Desk -->
            <Rectangle x:Name="Desk" Canvas.Left="16" Canvas.Top="150" Width="168" Height="8" RadiusX="2" RadiusY="2"
                       Fill="#B98A56" />
            <Rectangle Canvas.Left="16" Canvas.Top="158" Width="168" Height="4" Fill="#8C6539" />

            <!-- Study books, stacked at the corner of the desk (static, PRD-inspired desk dressing) -->
            <Rectangle Canvas.Left="20" Canvas.Top="136" Width="46" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#3E6B52" />
            <Rectangle Canvas.Left="22" Canvas.Top="128" Width="42" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#28477A" />
            <Rectangle Canvas.Left="24" Canvas.Top="120" Width="38" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#6E4028" />

            <!-- Pen cup -->
            <Rectangle Canvas.Left="158" Canvas.Top="128" Width="16" Height="18" RadiusX="2" RadiusY="2" Fill="#2E2E33" />
            <Line X1="163" Y1="130" X2="159" Y2="112" Stroke="#3A6EA5" StrokeThickness="2" StrokeStartLineCap="Round" />
            <Line X1="168" Y1="130" X2="171" Y2="110" Stroke="#D98A2E" StrokeThickness="2" StrokeStartLineCap="Round" />
            <Line X1="172" Y1="130" X2="176" Y2="114" Stroke="#2E2E33" StrokeThickness="2" StrokeStartLineCap="Round" />

            <!-- Zzz whimsy motif, off by default (PRD 8 'Could have') -->
            <TextBlock x:Name="ZzzMotif" Canvas.Left="128" Canvas.Top="18" Text="z z z" FontSize="16"
                       FontWeight="Bold" Foreground="#99FFFFFF" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="ZzzRotate" Angle="-10" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Torso group: pivots for the slouch/lean (Energy-driven base pose) -->
            <Grid x:Name="TorsoGroup" RenderTransformOrigin="0.5,1" Canvas.Left="0" Canvas.Top="0" Width="200" Height="200">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="TorsoRotate" Angle="0" CenterX="100" CenterY="150" />
                        <TranslateTransform x:Name="TorsoTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Canvas>
                    <!-- Back arm (behind torso), sleeve in the shirt's cream tone -->
                    <Line x:Name="BackArm" X1="120" Y1="110" X2="150" Y2="95" Stroke="#F2EAD8"
                          StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0,0">
                        <Line.RenderTransform>
                            <RotateTransform x:Name="BackArmRotate" Angle="0" CenterX="120" CenterY="110" />
                        </Line.RenderTransform>
                    </Line>

                    <!-- Chair back -->
                    <Rectangle Canvas.Left="70" Canvas.Top="70" Width="60" Height="80" RadiusX="10" RadiusY="10"
                               Fill="#22000000" />

                    <!-- Torso: white shirt base -->
                    <Path Fill="#F2EAD8">
                        <Path.Data>
                            <PathGeometry Figures="M 70,150 C 70,110 80,90 100,90 C 120,90 130,110 130,150 Z" />
                        </Path.Data>
                    </Path>

                    <!-- Vest (ikat-inspired), open at the front over the shirt -->
                    <Path x:Name="TorsoBody" Fill="#1F2A44">
                        <Path.Data>
                            <PathGeometry Figures="M 71,150 C 71,114 79,92 92,90 L 96,150 Z M 129,150 C 129,114 121,92 108,90 L 104,150 Z" />
                        </Path.Data>
                    </Path>

                    <!-- Ikat diamond accents on the vest panels -->
                    <Path Fill="#2E7D6B" Opacity="0.85">
                        <Path.Data>
                            <PathGeometry Figures="M 82,108 L 87,116 L 82,124 L 77,116 Z M 118,108 L 123,116 L 118,124 L 113,116 Z" />
                        </Path.Data>
                    </Path>
                    <Path Fill="#E8DCC0" Opacity="0.7">
                        <Path.Data>
                            <PathGeometry Figures="M 82,128 L 86,134 L 82,140 L 78,134 Z M 118,128 L 122,134 L 118,140 L 114,134 Z" />
                        </Path.Data>
                    </Path>

                    <!-- Shirt collar V -->
                    <Path Fill="#F2EAD8">
                        <Path.Data>
                            <PathGeometry Figures="M 92,90 L 100,102 L 108,90 L 100,96 Z" />
                        </Path.Data>
                    </Path>

                    <!-- Front arm (writing arm), sleeve then hand -->
                    <Line x:Name="FrontArm" X1="90" Y1="112" X2="70" Y2="132" Stroke="#F2EAD8"
                          StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0,0">
                        <Line.RenderTransform>
                            <RotateTransform x:Name="FrontArmRotate" Angle="0" CenterX="90" CenterY="112" />
                        </Line.RenderTransform>
                    </Line>
                    <Ellipse Canvas.Left="63" Canvas.Top="126" Width="12" Height="12" Fill="#E8B98C" />
                    <Line X1="60" Y1="124" X2="76" Y2="138" Stroke="#2E5DA8" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                    <!-- Hand accessory: a small teacup, hidden unless a sip/drink action plays -->
                    <Ellipse x:Name="CoffeeCup" Canvas.Left="58" Canvas.Top="126" Width="14" Height="10"
                             Fill="#E4E4E8" Opacity="0" />

                    <!-- Head group: separate pivot so it can droop/nod independent of torso lean -->
                    <Grid x:Name="HeadGroup" RenderTransformOrigin="0.5,1" Canvas.Left="0" Canvas.Top="0" Width="200"
                          Height="200">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="HeadRotate" Angle="0" CenterX="100" CenterY="88" />
                                <TranslateTransform x:Name="HeadTranslate" X="0" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Canvas>
                            <!-- Ears -->
                            <Ellipse Canvas.Left="75" Canvas.Top="76" Width="7" Height="10" Fill="#E8B98C" />
                            <Ellipse Canvas.Left="118" Canvas.Top="76" Width="7" Height="10" Fill="#E8B98C" />

                            <Ellipse x:Name="Head" Canvas.Left="78" Canvas.Top="58" Width="44" Height="44"
                                     Fill="#E8B98C" />

                            <!-- Hair -->
                            <Path x:Name="HairPath" Fill="#1C1712">
                                <Path.Data>
                                    <PathGeometry Figures="M 77,70 C 76,54 87,48 100,48 C 113,48 124,54 123,70 C 120,60 112,58 106,62 C 108,56 104,54 100,56 C 96,54 92,56 94,62 C 88,58 80,60 77,70 Z" />
                                </Path.Data>
                            </Path>

                            <!-- Doppi (traditional black embroidered cap) -->
                            <Path Fill="#141414">
                                <Path.Data>
                                    <PathGeometry Figures="M 79,54 C 79,42 88,34 100,34 C 112,34 121,42 121,54 C 121,56 119,58 117,58 L 83,58 C 81,58 79,56 79,54 Z" />
                                </Path.Data>
                            </Path>
                            <Rectangle Canvas.Left="79" Canvas.Top="49" Width="42" Height="7" Fill="#0B0B0B" />
                            <Path Stroke="#EDEDED" StrokeThickness="1.4" Opacity="0.9">
                                <Path.Data>
                                    <PathGeometry Figures="M 82,52.5 L 86,49.5 L 90,52.5 M 92,52.5 L 96,49.5 L 100,52.5 M 102,52.5 L 106,49.5 L 110,52.5 M 112,52.5 L 116,49.5 L 118,52.5" />
                                </Path.Data>
                            </Path>

                            <!-- Eyebrows -->
                            <Path Stroke="#1C1712" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry Figures="M 88,73 Q 92,71 96,73 M 104,73 Q 108,71 112,73" />
                                </Path.Data>
                            </Path>

                            <!-- Eyes -->
                            <Ellipse x:Name="EyeLeft" Canvas.Left="89" Canvas.Top="76" Width="7" Height="7" Fill="#2B1D14"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="EyeLeftScale" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="EyeRight" Canvas.Left="104" Canvas.Top="76" Width="7" Height="7" Fill="#2B1D14"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="EyeRightScale" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Cheeks (subtle) -->
                            <Ellipse Canvas.Left="84" Canvas.Top="86" Width="8" Height="5" Fill="#E8927A" Opacity="0.35" />
                            <Ellipse Canvas.Left="108" Canvas.Top="86" Width="8" Height="5" Fill="#E8927A" Opacity="0.35" />

                            <!-- Mouth: neutral vs yawn, crossfaded -->
                            <Path x:Name="MouthNeutral" Stroke="#8A4A3A" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Opacity="1">
                                <Path.Data>
                                    <PathGeometry Figures="M 94,92 Q 100,96 106,92" />
                                </Path.Data>
                            </Path>
                            <Ellipse x:Name="MouthYawn" Canvas.Left="93" Canvas.Top="88" Width="14" Height="10"
                                     Fill="#5A3A3A" Opacity="0" />
                        </Canvas>
                    </Grid>
                </Canvas>
            </Grid>
        </Canvas>
    </Viewbox>
</UserControl>
