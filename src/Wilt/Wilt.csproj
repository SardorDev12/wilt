<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!--
      Disabled: with both UseWPF and UseWindowsForms set, ImplicitUsings
      auto-injects global usings for BOTH System.Windows and
      System.Windows.Forms/System.Drawing project-wide, which makes
      "Application", "Brush", etc. ambiguous even in files that never
      reference WinForms. Every file in this project already has its own
      explicit using directives, so this is safe to turn off.
    -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Wilt</AssemblyName>
    <RootNamespace>Wilt</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Product>Wilt</Product>
    <Company>Wilt</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Characters\student.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- SAPI-based speech synthesis for the end-of-session voice line.
         A plain <Reference Include="System.Speech" /> relies on it already
         being on the machine's framework reference list, which isn't
         guaranteed - the NuGet package resolves reliably instead. -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

</Project>
