<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WiltAccentBrush" Color="#2E7D6B" />
    <SolidColorBrush x:Key="WiltAccentDimBrush" Color="#552E7D6B" />
    <SolidColorBrush x:Key="WiltTextBrush" Color="#F5F3EE" />
    <SolidColorBrush x:Key="WiltTextDimBrush" Color="#B8B5AE" />
    <SolidColorBrush x:Key="WiltWindowBgBrush" Color="#F5F5F7" />

    <!-- "Glass" capsule chrome: a dark translucent fill, a faint top highlight
         edge, and a soft outer glow, used for both the control strip and the
         clock/controls capsule so the whole widget reads as one cohesive
         material rather than flat boxes. -->
    <LinearGradientBrush x:Key="WiltCapsuleBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E4232329" Offset="0" />
        <GradientStop Color="#EE17171B" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WiltCapsuleBorderBrush" Color="#22FFFFFF" />

    <Style x:Key="WiltCapsuleBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WiltCapsuleBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WiltCapsuleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.35" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WiltIconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource WiltTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource WiltAccentDimBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource WiltAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Wide labeled accent pill ("Start Focus", "Start Break", "Resume"),
         shown over the character whenever the user needs to explicitly kick
         something off, so it reads as a real call-to-action. -->
    <Style x:Key="WiltPrimaryPillButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Foreground" Value="{StaticResource WiltTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource WiltAccentBrush}" CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
