<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WiltAccentBrush" Color="#8BC3A8" />
    <SolidColorBrush x:Key="WiltAccentDimBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="WiltTextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="WiltControlBgBrush" Color="#CC2B2B33" />
    <SolidColorBrush x:Key="WiltWindowBgBrush" Color="#F5F5F7" />

    <Style x:Key="WiltIconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="{StaticResource WiltControlBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WiltTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
