<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WiltAccentBrush" Color="#2E7D6B" />
    <SolidColorBrush x:Key="WiltAccentDimBrush" Color="#552E7D6B" />
    <SolidColorBrush x:Key="WiltTextBrush" Color="#F5F3EE" />
    <SolidColorBrush x:Key="WiltTextDimBrush" Color="#B8B5AE" />
    <SolidColorBrush x:Key="WiltWindowBgBrush" Color="#F5F5F7" />

    <!-- "Glass" capsule chrome: a dark translucent fill, a faint top highlight
         edge, and a soft outer glow, used for both the control strip and the
         clock/controls capsule so the whole widget reads as one cohesive
         material rather than flat boxes. -->
    <LinearGradientBrush x:Key="WiltCapsuleBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2232329" Offset="0" />
        <GradientStop Color="#FA17171B" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WiltCapsuleBorderBrush" Color="#40FFFFFF" />

    <!-- Subtle per-row "chip" fill for Task Mode list rows, so each task reads
         as its own card against the dark capsule instead of floating text. -->
    <SolidColorBrush x:Key="WiltRowChipBrush" Color="#18FFFFFF" />

    <Style x:Key="WiltCapsuleBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WiltCapsuleBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WiltCapsuleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.35" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WiltIconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource WiltTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource WiltAccentDimBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource WiltAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin, theme-colored scrollbar for the overlay's Task list - no arrow
         buttons, just a track and a slim thumb, instead of Windows' default
         wide chrome scrollbar. Keyed rather than a global TargetType style:
         Settings/Task Manager are plain light windows where this dark-glass
         thumb color would be barely visible, so it's applied explicitly via
         TaskListScroll's own Resources instead of app-wide. -->
    <SolidColorBrush x:Key="WiltScrollThumbBrush" Color="#30FFFFFF" />

    <Style x:Key="WiltScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource WiltScrollThumbBrush}" CornerRadius="1.5"
                            Margin="3,0,1,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The clickable hit area (Width) stays wide enough to grab with a
         mouse; the Thumb's own Margin above draws it as a slim 3px line
         within that area instead of a bold pill. -->
    <Style x:Key="WiltScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource WiltScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dark, theme-matching text field (WPF's default TextBox renders a
         plain white box, which clashes hard against this dark glass UI and
         was hard to tell apart from its neighbor without a label). -->
    <Style x:Key="WiltTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#22FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource WiltTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource WiltTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WiltCapsuleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource WiltAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Wide labeled accent pill ("Start Focus", "Start Break", "Resume"),
         shown over the character whenever the user needs to explicitly kick
         something off, so it reads as a real call-to-action. -->
    <Style x:Key="WiltPrimaryPillButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Foreground" Value="{StaticResource WiltTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource WiltAccentBrush}" CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
