<Window x:Class="Wilt.Views.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Tasks" Height="520" Width="640" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WiltWindowBgBrush}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="All tasks" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,10,0,0"
                Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="NewNameBox" Width="180" Margin="0,0,6,0" VerticalContentAlignment="Center"
                         ToolTip="Task name" />
                <TextBox x:Name="NewMinutesBox" Width="60" Margin="0,0,6,0" VerticalContentAlignment="Center"
                         ToolTip="Planned minutes" PreviewTextInput="OnMinutesPreviewTextInput" />
                <DatePicker x:Name="NewDatePicker" Width="120" Margin="0,0,6,0" />
                <Button Content="Add task" Padding="12,4" Click="OnAddClick" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  RowHeaderWidth="0" AlternatingRowBackground="#F3F3F5" CellEditEnding="OnCellEditEnding">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Date" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Date, StringFormat='MMM d, yyyy'}" Margin="4,0"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Task name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Planned (min)" Binding="{Binding PlannedMinutes}" Width="100" />
                <DataGridTextColumn Header="Worked (min)" Binding="{Binding WorkedMinutes}" IsReadOnly="True"
                                     Width="100" />
                <DataGridCheckBoxColumn Header="Done" Binding="{Binding IsDone}" Width="50" />

                <DataGridTemplateColumn Header="" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Padding="6,2" Click="OnDeleteClick" Tag="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
