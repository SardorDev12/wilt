<Window x:Class="Wilt.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wilt.Controls"
        x:Name="Root"
        Title="Wilt"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseEnter="OnMouseEnterOverlay"
        MouseLeave="OnMouseLeaveOverlay">
    <Grid x:Name="RootGrid" Background="#01000000" PreviewMouseLeftButtonDown="OnRootPreviewMouseLeftButtonDown">
        <!--
          Background is alpha=1 (imperceptible) rather than fully transparent
          on purpose: this is a per-pixel-alpha layered window (AllowsTransparency),
          so Windows only routes mouse input to pixels that are actually drawn.
          A truly transparent (alpha=0) area never receives hover/click at all,
          which is why the control strip only appeared when the cursor landed on
          an exact rendered pixel. This near-invisible background makes the
          whole widget rectangle hoverable.
        -->
        <!--
          LayoutTransform, not RenderTransform: RenderTransform is purely
          visual and doesn't participate in measure/arrange, so with
          SizeToContent the window would size itself to the *unscaled*
          content and clip anything the transform pushes past that - which
          is exactly why the character got cut off above a certain size.
          LayoutTransform is measured before the parent sizes itself, so the
          window (and its click-through hit-test area) always grows to fit.
        -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">

            <!-- Hover control strip: skip / settings / click-through / quit (PRD 9.1, 9.3).
                 The click-through button only really matters while click-through is OFF
                 here - once it's ON, this whole strip (and the rest of the window) stops
                 receiving mouse input entirely at the OS level, so a separate always-on-top
                 ClickThroughIndicatorWindow (never made click-through itself) takes over as
                 the one thing still clickable, letting the user always turn it back off. -->
            <Border x:Name="ControlStrip" Style="{StaticResource WiltCapsuleBorder}" CornerRadius="15"
                    Padding="7,4" Margin="0,0,0,8" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SkipButton" Content="⏭" Style="{StaticResource WiltIconButton}" Click="OnSkipClick"
                            ToolTip="Skip to next phase" Margin="0,0,4,0" />
                    <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource WiltIconButton}"
                            Click="OnSettingsClick" ToolTip="Settings" Margin="0,0,4,0" />
                    <Button x:Name="ClickThroughButton" Content="🔒" Style="{StaticResource WiltIconButton}"
                            Click="OnClickThroughToggleClick" ToolTip="Toggle click-through" Margin="0,0,4,0" />
                    <Button x:Name="QuitButton" Content="⏻" Style="{StaticResource WiltIconButton}" Click="OnQuitClick"
                            ToolTip="Quit Wilt" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="PomodoroModeHost" Orientation="Vertical" HorizontalAlignment="Center">
                <!-- Shown once a phase's time runs out, while the clock keeps counting
                     into overtime instead of freezing - makes the moment hard to miss
                     without silently starting the next phase on its own. -->
                <Border x:Name="CompletionBanner" Style="{StaticResource WiltCapsuleBorder}"
                        BorderBrush="{StaticResource WiltAccentBrush}" Padding="10,5" Margin="0,0,0,8"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="CompletionBannerText" Text="Focus session complete!"
                               Foreground="{StaticResource WiltTextBrush}" FontSize="12" FontWeight="SemiBold" />
                </Border>

                <!-- Character (draggable) with the session-progress ring beside it. Both
                     poses are always in the tree; only the selected one is visible/active
                     (PRD-inspired "Could have": alternate poses, user-selectable in Settings).
                     The Start/Resume CTA sits directly over the character (not in the
                     clock row) so it's the first thing you see whenever it needs a click -
                     no animation needed to draw the eye when it's this obvious. -->
                <StackPanel x:Name="CharacterHost" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown">
                    <Grid>
                        <controls:CharacterControl x:Name="StandingCharacter" VerticalAlignment="Center" />
                        <controls:DeskCharacterControl x:Name="SittingCharacter" VerticalAlignment="Center"
                                                        Visibility="Collapsed" />
                        <Button x:Name="BigStartButton" Content="▶ Start" Style="{StaticResource WiltPrimaryPillButton}"
                                Click="OnPlayPauseClick" ToolTip="Start" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10,0,0,0">
                        <controls:ProgressRing x:Name="Ring" Diameter="64" Thickness="4" HorizontalAlignment="Center" />
                        <!-- Progress toward the next long break, e.g. "2/4" -->
                        <TextBlock x:Name="SessionsCounterText" Text="0/4" Foreground="{StaticResource WiltTextDimBrush}"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"
                                   ToolTip="Focus sessions completed toward the next long break" />
                    </StackPanel>
                </StackPanel>

                <!-- Clock + secondary controls, always reachable with a single click (PRD 9.1.1) -->
                <Border Style="{StaticResource WiltCapsuleBorder}" Padding="12,6" Margin="0,8,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TimeText" Text="25:00" Foreground="{StaticResource WiltTextBrush}"
                                   FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI Semibold"
                                   VerticalAlignment="Center" Margin="3,0,10,0" MinWidth="46" />
                        <Button x:Name="PauseButton" Content="⏸" Style="{StaticResource WiltIconButton}"
                                Click="OnPlayPauseClick" ToolTip="Pause" Visibility="Collapsed" />
                        <Button x:Name="FinishButton" Content="⏹" Style="{StaticResource WiltIconButton}"
                                Click="OnFinishClick" ToolTip="Finish session" Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Task Mode: a pure list view (no character, PRD-inspired decision: "others
                 go default") showing only today's tasks. Tasks left undone from a previous
                 day don't appear inline - they surface as a dismissible/movable "missed"
                 list behind the bell badge instead. -->
            <StackPanel x:Name="TaskModeHost" Orientation="Vertical" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Border x:Name="TaskTopBar" Style="{StaticResource WiltCapsuleBorder}" Padding="12,6" Margin="0,0,0,8"
                        HorizontalAlignment="Stretch" MinWidth="260" MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="TaskClockText" Text="00:00" Foreground="{StaticResource WiltTextBrush}"
                                   FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI Semibold"
                                   VerticalAlignment="Center" Margin="3,0,10,0" MinWidth="46" />
                        <Grid Margin="0,0,4,0" Visibility="Collapsed" x:Name="MissedBadgeHost">
                            <Button x:Name="MissedBadgeButton" Content="🔔" Style="{StaticResource WiltIconButton}"
                                    Click="OnMissedBadgeClick" ToolTip="Missed tasks" />
                            <Border Background="{StaticResource WiltAccentBrush}" CornerRadius="7" Width="14" Height="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="MissedCountText" Text="0" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource WiltTextBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Button x:Name="TaskNextButton" Content="⏭" Style="{StaticResource WiltIconButton}"
                                Click="OnTaskNextClick" ToolTip="Next task" Margin="0,0,4,0" />
                        <Button x:Name="TaskPauseButton" Content="⏸" Style="{StaticResource WiltIconButton}"
                                Click="OnTaskPauseClick" ToolTip="Pause" Margin="0,0,4,0" />
                        <Button x:Name="TaskSettingsButton" Content="⚙" Style="{StaticResource WiltIconButton}"
                                Click="OnSettingsClick" ToolTip="Settings" Margin="0,0,4,0" />
                        <Button x:Name="TaskClickThroughButton" Content="🔒" Style="{StaticResource WiltIconButton}"
                                Click="OnClickThroughToggleClick" ToolTip="Toggle click-through" Margin="0,0,4,0" />
                        <Button x:Name="TaskCloseButton" Content="⏻" Style="{StaticResource WiltIconButton}"
                                Click="OnQuitClick" ToolTip="Quit Wilt" />
                    </StackPanel>
                </Border>

                <Border x:Name="MissedPanel" Style="{StaticResource WiltCapsuleBorder}" Padding="10,8" Margin="0,0,0,8"
                        HorizontalAlignment="Stretch" MinWidth="260" Visibility="Collapsed">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Missed" Foreground="{StaticResource WiltTextDimBrush}" FontSize="11"
                                   Margin="2,0,0,6" />
                        <StackPanel x:Name="MissedRowsPanel" Orientation="Vertical" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WiltCapsuleBorder}" Padding="10,8" HorizontalAlignment="Stretch"
                        MinWidth="260" MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Tasks:" Foreground="{StaticResource WiltTextBrush}" FontSize="13"
                                   FontWeight="SemiBold" Margin="2,0,0,8" />

                        <!-- Capped at 5 visible rows; a longer list scrolls instead of growing the window. -->
                        <ScrollViewer x:Name="TaskListScroll" MaxHeight="165" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="TaskRowsPanel" Orientation="Vertical" />
                        </ScrollViewer>

                        <TextBlock x:Name="NoTasksText" Text="No tasks yet today." FontSize="12"
                                   Foreground="{StaticResource WiltTextBrush}" Opacity="0.75" Margin="2,4,0,0"
                                   Visibility="Collapsed" />

                        <Border x:Name="AddTaskRow" Margin="2,8,0,0" Cursor="Hand"
                                MouseLeftButtonDown="OnInteractiveRowMouseLeftButtonDown"
                                MouseLeftButtonUp="OnAddTaskRowClick" Background="#01FFFFFF">
                            <TextBlock Text="+ Add task" Foreground="{StaticResource WiltAccentBrush}" FontSize="13"
                                       FontWeight="SemiBold" />
                        </Border>

                        <StackPanel x:Name="AddTaskForm" Orientation="Vertical" Margin="2,8,0,0"
                                    Visibility="Collapsed" MouseLeftButtonDown="OnInteractiveRowMouseLeftButtonDown">
                            <TextBlock Text="Task name" FontSize="10" Foreground="{StaticResource WiltTextDimBrush}"
                                       Margin="2,0,0,3" />
                            <TextBox x:Name="NewTaskNameBox" Style="{StaticResource WiltTextBox}"
                                     KeyDown="OnAddTaskFieldKeyDown" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Bottom">
                                    <TextBlock Text="Minutes" FontSize="10" Foreground="{StaticResource WiltTextDimBrush}"
                                               Margin="2,0,0,3" />
                                    <TextBox x:Name="NewTaskMinutesBox" Style="{StaticResource WiltTextBox}"
                                             ToolTip="Planned minutes" MaxLength="4" KeyDown="OnAddTaskFieldKeyDown"
                                             PreviewTextInput="OnMinutesPreviewTextInput"
                                             CommandManager.PreviewExecuted="OnMinutesPreviewExecuted" />
                                </StackPanel>

                                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource WiltIconButton}"
                                        Width="56" VerticalAlignment="Bottom" Margin="8,0,6,0"
                                        Click="OnCancelAddTaskClick" />
                                <Button Grid.Column="3" Content="Add" Style="{StaticResource WiltPrimaryPillButton}"
                                        Height="26" Padding="14,0" VerticalAlignment="Bottom"
                                        Click="OnConfirmAddTaskClick" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
