<Window x:Class="Wilt.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wilt Settings" Height="560" Width="420" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" Background="{StaticResource WiltWindowBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <TextBlock Text="Timer" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <TextBlock Text="Focus duration (min)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox x:Name="FocusMinutesBox" Grid.Row="0" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                         TextChanged="OnTimerFieldChanged" />

                <TextBlock Text="Short break (min)" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox x:Name="ShortBreakMinutesBox" Grid.Row="1" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                         TextChanged="OnTimerFieldChanged" />

                <TextBlock Text="Long break (min)" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox x:Name="LongBreakMinutesBox" Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                         TextChanged="OnTimerFieldChanged" />

                <TextBlock Text="Sessions until long break" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox x:Name="SessionsUntilLongBreakBox" Grid.Row="3" Grid.Column="1" Width="70"
                         HorizontalAlignment="Left" TextChanged="OnTimerFieldChanged" />
            </Grid>

            <Separator Margin="0,12" />

            <TextBlock Text="Overlay" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

            <TextBlock Text="Size" Margin="0,4,0,0" />
            <Slider x:Name="OverlaySizeSlider" Minimum="0.2" Maximum="8.0" Value="1.0" TickFrequency="0.1"
                    ValueChanged="OnOverlaySizeChanged" />

            <TextBlock Text="Opacity" Margin="0,8,0,0" />
            <Slider x:Name="OverlayOpacitySlider" Minimum="0.2" Maximum="1.0" Value="1.0" TickFrequency="0.05"
                    ValueChanged="OnOverlayOpacityChanged" />

            <CheckBox x:Name="ClickThroughCheckBox" Content="Click-through (mouse clicks pass to the app underneath)"
                      Margin="0,10,0,0" Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged" />

            <TextBlock Text="Character pose" Margin="0,10,0,4" />
            <ComboBox x:Name="PoseComboBox" SelectionChanged="OnPoseChanged" HorizontalAlignment="Left" Width="150">
                <ComboBoxItem Content="Standing" Tag="Standing" />
                <ComboBoxItem Content="Sitting at a desk" Tag="SittingAtDesk" />
            </ComboBox>

            <TextBlock Text="Character skin" Margin="0,10,0,4" />
            <ComboBox x:Name="SkinComboBox" SelectionChanged="OnSkinChanged" HorizontalAlignment="Left" Width="150">
                <ComboBoxItem Content="Slate" Tag="Slate" />
                <ComboBoxItem Content="Amber" Tag="Amber" />
                <ComboBoxItem Content="Mint" Tag="Mint" />
            </ComboBox>

            <CheckBox x:Name="WhimsyCheckBox" Content="Whimsical touches when Exhausted (e.g. a &quot;zzz&quot; motif)"
                      Margin="0,10,0,0" Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged" />

            <Separator Margin="0,12" />

            <TextBlock Text="Sound &amp; startup" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
            <CheckBox x:Name="SoundEnabledCheckBox" Content="Play a sound at the end of each session/break"
                      Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged" />
            <CheckBox x:Name="LaunchOnStartupCheckBox" Content="Launch Wilt when Windows starts" Margin="0,8,0,0"
                      Checked="OnLaunchOnStartupChanged" Unchecked="OnLaunchOnStartupChanged" />
            <CheckBox x:Name="GlobalHotkeysCheckBox" Content="Enable global hotkeys (Ctrl+Alt+P start/pause, Ctrl+Alt+S skip)"
                      Margin="0,8,0,0" Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged" />

            <Separator Margin="0,12" />

            <TextBlock Text="Idle detection" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
            <CheckBox x:Name="IdleDetectionCheckBox"
                      Content="Auto-pause Focus sessions when there's no keyboard/mouse activity"
                      Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="After (minutes)" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="IdleTimeoutMinutesBox" Width="50" TextChanged="OnIdleTimeoutChanged" />
            </StackPanel>

            <Separator Margin="0,12" />

            <TextBlock Text="Stats (local only)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
            <TextBlock x:Name="StatsText" Text="Focus sessions — today: 0, this week: 0, all time: 0" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</Window>
